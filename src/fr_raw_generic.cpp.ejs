void <%=name%>_rawFromMontgomery(<%=name%>RawElement pRawResult, const <%=name%>RawElement &pRawA)
{
    constexpr size_t N = <%=name%>_N64 + 1;
    const uint64_t *mq = <%=name%>_rawq;

    uint64_t np0;
<% if (!canOptimizeConsensys) { %>
    uint64_t c = 0;
<% } %>

    uint64_t product0[N];
<% for (let i=1; i<n64; i++) { %>
    uint64_t product<%=i%>[N] = {0};
<% } %>

    mp_copy(product0, pRawA);
    product0[<%=n64%>] = 0;

<% for (let i=0; i<n64-1; i++) { %>
    np0 = <%=name%>_np * product<%=i%>[0];
<% if (!canOptimizeConsensys) { %>
    c += mp_addmul(product<%=i%>, mq, N, np0);
<% } else { %>
    product<%=i+1%>[1] = mp_addmul(product<%=i%>, mq, N, np0);
<% } %>

<% if (!canOptimizeConsensys) { %>
    product<%=i+1%>[<%=n64%>] += c;
    c = mp_add(product<%=i+1%>, product<%=i+1%>, N, product<%=i%> + 1, N - 1);
<% } else { %>
    mp_add(product<%=i+1%>, product<%=i+1%>, N, product<%=i%> + 1, N - 1);
<% } %>
<% } %>

    np0 = <%=name%>_np * product<%=n64-1%>[0];
<% if (!canOptimizeConsensys) { %>
    c += mp_addmul(product<%=n64-1%>, mq, N, np0);
<% } else { %>
    mp_addmul(product<%=n64-1%>, mq, N, np0);
<% } %>

    mp_copy(pRawResult, product<%=n64-1%> + 1);

<% if (!canOptimizeConsensys) { %>
    if (c || mp_cmp(pRawResult, mq) >= 0)
<% } else { %>
    if (mp_cmp(pRawResult, mq) >= 0)
<% } %>
    {
        mp_sub(pRawResult, pRawResult, mq);
    }
}

int <%=name%>_rawIsZero(const <%=name%>RawElement rawA)
{
    return mp_is_zero(rawA) ? 1 : 0;
}

int <%=name%>_rawCmp(<%=name%>RawElement pRawA, <%=name%>RawElement pRawB)
{
    return mp_cmp(pRawA, pRawB);
}

void <%=name%>_rawSwap(<%=name%>RawElement pRawResult, <%=name%>RawElement pRawA)
{
    <%=name%>RawElement temp;

<% for (let i=0; i<n64; i++) { %>
    temp[<%=i%>] = pRawResult[<%=i%>];
<% } %>

<% for (let i=0; i<n64; i++) { %>
    pRawResult[<%=i%>] = pRawA[<%=i%>];
<% } %>

<% for (let i=0; i<n64; i++) { %>
    pRawA[<%=i%>] = temp[<%=i%>];
<% } %>
}

void <%=name%>_rawCopyS2L(<%=name%>RawElement pRawResult, int64_t val)
{
    pRawResult[0] = val;
<% for (let i=1; i<n64; i++) { %>
    pRawResult[<%=i%>] = 0;
<% } %>

    if (val < 0)
    {
<% for (let i=1; i<n64; i++) { %>
        pRawResult[<%=i%>] = (uint64_t)-1;
<% } %>

        mp_add(pRawResult, pRawResult, <%=name%>_rawq);
    }
}

void <%=name%>_rawAnd(<%=name%>RawElement pRawResult, <%=name%>RawElement pRawA, <%=name%>RawElement pRawB)
{
    mp_and(pRawResult, pRawA, pRawB);

    pRawResult[<%=n64-1%>] &= lboMask;

    if (mp_cmp(pRawResult, <%=name%>_rawq) >= 0)
    {
        mp_sub(pRawResult, pRawResult, <%=name%>_rawq);
    }
}

void <%=name%>_rawOr(<%=name%>RawElement pRawResult, <%=name%>RawElement pRawA, <%=name%>RawElement pRawB)
{
    mp_or(pRawResult, pRawA, pRawB);

    pRawResult[<%=n64-1%>] &= lboMask;

    if (mp_cmp(pRawResult, <%=name%>_rawq) >= 0)
    {
        mp_sub(pRawResult, pRawResult, <%=name%>_rawq);
    }
}

void <%=name%>_rawXor(<%=name%>RawElement pRawResult, <%=name%>RawElement pRawA, <%=name%>RawElement pRawB)
{
    mp_xor(pRawResult, pRawA, pRawB);

    pRawResult[<%=n64-1%>] &= lboMask;

    if (mp_cmp(pRawResult, <%=name%>_rawq) >= 0)
    {
        mp_sub(pRawResult, pRawResult, <%=name%>_rawq);
    }
}

void <%=name%>_rawShl(<%=name%>RawElement r, <%=name%>RawElement a, uint64_t b)
{
    mp_shl(r, a, (uint32_t)b);

    r[<%=n64-1%>] &= lboMask;

    if (mp_cmp(r, <%=name%>_rawq) >= 0)
    {
        mp_sub(r, r, <%=name%>_rawq);
    }
}

void <%=name%>_rawShr(<%=name%>RawElement r, <%=name%>RawElement a, uint64_t b)
{
    mp_shr(r, a, (uint32_t)b);
}

void <%=name%>_rawNot(<%=name%>RawElement pRawResult, <%=name%>RawElement pRawA)
{
    mp_not(pRawResult, pRawA);

    pRawResult[<%=n64-1%>] &= lboMask;

    if (mp_cmp(pRawResult, <%=name%>_rawq) >= 0)
    {
        mp_sub(pRawResult, pRawResult, <%=name%>_rawq);
    }
}
